<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
    colors="true"
    backupGlobals="false"
    bootstrap="./bootstrap.php"
    cacheResultFile=".phpunit.cache/test-results"
    executionOrder="depends,defects"
    forceCoversAnnotation="false"
    beStrictAboutCoversAnnotation="false"
    beStrictAboutOutputDuringTests="false"
    beStrictAboutTodoAnnotatedTests="true"
    failOnRisky="false"
    failOnWarning="false"
    verbose="true"
>
    <testsuites>
        <testsuite name="ExeLearningTest">
            <directory>./ExeLearningTest</directory>
        </testsuite>
    </testsuites>

    <!--
        Reports are requested on the command line by `make test-coverage`, not
        declared here, so plain `make test` does not pay for coverage it never
        prints.
    -->
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">../src</directory>
            <!--
                Module.php is a quarter of the codebase and holds every Omeka
                event hook. It was outside the gate until the stubs under
                test/Stubs/Omeka/Module/ made it loadable without an Omeka
                runtime. See ADR-32-01.
            -->
            <file>../Module.php</file>
        </include>
        <exclude>
            <directory suffix="Factory.php">../src</directory>
        </exclude>
    </coverage>
</phpunit>
