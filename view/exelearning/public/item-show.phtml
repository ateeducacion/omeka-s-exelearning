<?php
/**
 * Public item show partial - displays eXeLearning content in an iframe.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\MediaRepresentation $media
 * @var string $contentPath  Relative path: /exelearning/content/{hash}/index.html
 */

use ExeLearning\Service\DownloadFormats;
use ExeLearning\Service\IframeSandbox;

$exeIframeMode = IframeSandbox::MODE_SECURE;
try {
    $exeIframeMode = IframeSandbox::normalizeMode($this->setting('exelearning_iframe_mode', 'secure'));
} catch (\Throwable $e) {
    $exeIframeMode = IframeSandbox::MODE_SECURE;
}

$exeStoredFormats = null;
try {
    $exeStoredFormats = $this->setting('exelearning_download_formats', null);
} catch (\Throwable $e) {
    $exeStoredFormats = null;
}
$exeFormatIds = $exeStoredFormats === null
    ? DownloadFormats::enabledByDefault()
    : DownloadFormats::sanitize($exeStoredFormats);
$exeShowDownload = !empty($exeFormatIds);
if ($exeShowDownload) {
    DownloadFormats::enqueueDownloadAssets($this);
    $this->headLink()->appendStylesheet(
        $this->assetUrl('css/exelearning.css', 'ExeLearning')
    );
}

// Secure mode: promote external embeds to this page (no-op in legacy). The embed
// policy (strict default | open) mirrors mod_exelearning's embedmode setting.
$exeEmbedMode = null;
try {
    $exeEmbedMode = $this->setting(IframeSandbox::EMBED_OPTION, IframeSandbox::EMBED_STRICT);
} catch (\Throwable $e) {
    $exeEmbedMode = IframeSandbox::EMBED_STRICT;
}
IframeSandbox::enqueueEmbedRelay($this, $exeIframeMode, $exeEmbedMode);
// Parent-side media host for the interactive-video iDevice in secure mode (DEC-0067).
?>

<style>
.exelearning-public-viewer {
    margin: 2rem 0;
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #fff;
    overflow: hidden;
}
.exelearning-public-viewer .viewer-header {
    padding: 0.75rem 1rem;
    background: #f5f5f5;
    border-bottom: 1px solid #ddd;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
}
.exelearning-public-viewer .viewer-title {
    font-weight: 600;
    margin: 0;
}
.exelearning-public-viewer .viewer-actions {
    display: flex;
    gap: 0.5rem;
}
.exelearning-public-viewer .viewer-actions a {
    padding: 0.4rem 0.8rem;
    background: #0073aa;
    color: #fff;
    text-decoration: none;
    border-radius: 3px;
    font-size: 0.875rem;
}
.exelearning-public-viewer .viewer-actions a:hover {
    background: #005a87;
}
.exelearning-public-viewer iframe {
    display: block;
    width: 100%;
    height: 700px;
    border: none;
}
</style>

<div class="exelearning-public-viewer">
    <div class="viewer-header">
        <h3 class="viewer-title"><?= $this->escapeHtml($media->displayTitle()) ?></h3>
        <div class="viewer-actions">
            <a data-exe-content-path="<?= $this->escapeHtmlAttr($contentPath) ?>" target="_blank" rel="noopener noreferrer">
                <?= $this->translate('Open fullscreen') ?>
            </a>
            <?php if ($exeShowDownload): ?>
                <?= DownloadFormats::renderSplitButton($this, $media, $exeFormatIds) ?>
            <?php endif; ?>
        </div>
    </div>
    <?php // Sandbox tokens come from the iframe-mode setting (default secure).
          // Secure = opaque origin (no allow-same-origin): author HTML/JS cannot
          // reach this page. Legacy restores allow-same-origin only where an
          // opaque iframe cannot be served (e.g. the php-wasm Playground, whose
          // service worker only intercepts same-origin documents). ?>
    <iframe
        data-exe-content-path="<?= $this->escapeHtmlAttr($contentPath) ?>"
        sandbox="<?= $this->escapeHtmlAttr(IframeSandbox::tokens($exeIframeMode)) ?>"
        referrerpolicy="no-referrer"
        allowfullscreen></iframe>
</div>

<script>
// Build content URLs using window.location so the playground SW scope prefix
// (/playground/{uuid}/php83/) is included — PHP cannot see it, JS can.
(function() {
    var href = window.location.href;
    var base = href;
    ['/admin/', '/s/', '/api/'].some(function(m) {
        var idx = href.indexOf(m);
        if (idx !== -1) { base = href.substring(0, idx); return true; }
        return false;
    });
    window.exelearningContentBase = base;
    document.querySelectorAll('[data-exe-content-path]').forEach(function(el) {
        var url = base + el.getAttribute('data-exe-content-path');
        el.tagName === 'IFRAME' ? (el.src = url) : (el.href = url);
    });
})();
</script>
